     format_comparison_summary, format_results
 )
 
+# ---------------------------------------------------------------------------
+# Claude (Anthropic) backend wiring.
+#
+# The Agents SDK talks to any OpenAI-compatible endpoint. Anthropic serves one
+# at /v1/chat/completions, so we point the default client there and force the
+# chat_completions API (the SDK defaults to the Responses API, which Anthropic
+# does not implement). Tracing is disabled because it would otherwise upload to
+# OpenAI's tracing backend using an OpenAI key we do not have.
+#
+# Gated so importing this module stays side-effect-free unless a key or an
+# explicit base-URL override is present (ASTRA_BASE_URL also lets tests point
+# the SDK at a local stub server).
+# ---------------------------------------------------------------------------
+ASTRA_MODEL = os.environ.get("ASTRA_MODEL", "claude-opus-4-7")
+
+if os.environ.get("ANTHROPIC_API_KEY") or os.environ.get("ASTRA_BASE_URL"):
+    from agents import (
+        set_default_openai_client,
+        set_default_openai_api,
+        set_tracing_disabled,
+    )
+    from openai import AsyncOpenAI
+
+    _astra_client = AsyncOpenAI(
+        base_url=os.environ.get("ASTRA_BASE_URL", "https://api.anthropic.com/v1/"),
+        api_key=os.environ.get("ANTHROPIC_API_KEY", "dummy-key-for-offline"),
+    )
+    set_default_openai_client(_astra_client, use_for_tracing=False)
+    set_default_openai_api("chat_completions")
+    set_tracing_disabled(True)
+
 # Configure logging
 logging.basicConfig(
     level=logging.INFO,
