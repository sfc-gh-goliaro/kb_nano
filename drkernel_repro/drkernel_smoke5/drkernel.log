[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # loads
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         a = tl.load(a_ptrs, mask=a_mask, other=0.0)       # (BM, BK)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         b = tl.load(b_ptrs, mask=b_mask, other=0.0)       # (BK, BN)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # accumulate: (BM, BK) @ (BK, BN) -> (BM, BN)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         acc += tl.dot(a, b)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # store result
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     c_ptrs = C_ptr + (offs_m[:, None] * stride_cm) + (offs_n[None, :] * stride_cn)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     out_mask = (offs_m[:, None] < M) & (offs_n[None, :] < N)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     tl.store(c_ptrs, acc, mask=out_mask)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
