[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # In-register inclusive scan via Hillis–Steele
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # v = sum_{d=0}^{LOG2-1} (vals shifted right by 2^d)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         d = 0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         while d < LOG2:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             shift = 1 << d  # 2^d
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             # s = where(cols >= shift, vals, 0)     -> includes v[l-shift] where l>=shift
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             # But that also includes v[0] at positions < shift via padding.
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             # We need pure shifted component for this step: spure = s - where(cols >= 2*shift, vals, 0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             cond_shift = cols >= shift
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             cond_double = cols >= (2 * shift)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             s_tmp = tl.where(cond_shift, vals, 0.0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             s_dble = tl.where(cond_double, vals, 0.0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             s = s_tmp - s_dble
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             vals = vals + s
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             d += 1
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Store results for this tile
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         out_ptrs = y_ptr + row * stride_m + offs * stride_n
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         tl.store(out_ptrs, vals, mask=mask)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Update carry: last valid element of this tile
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Find the last in-range index: BLOCK-1 or max index where mask True.
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Simple: use BLOCK-1 and, if it's OOB, set carry = 0.
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         last_col = BLOCK - 1
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         in_last = (start + last_col) < N
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         carry = tl.where(in_last, vals[last_col], 0.0)
