[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         a_ptrs = A_ptr + (offs_m[:, None] * stride_am) + (offs_k[None, :] * stride_ak)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # B as (K, N): B[k, n]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         b_ptrs = B_ptr + (offs_k[:, None] * stride_bk) + (offs_n[None, :] * stride_bn)  # (BK, BN)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # masks
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         a_mask = (offs_m[:, None] < M) & (offs_k[None, :] < K)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         b_mask = (offs_k[:, None] < K) & (offs_n[None, :] < N)
