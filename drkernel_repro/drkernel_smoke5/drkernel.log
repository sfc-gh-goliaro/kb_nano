[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m @triton.jit
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m def _cumsum_rows_blocks_kernel(
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     x_ptr, out_ptr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     stride_x_row, stride_x_col,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     stride_out_row, stride_out_col,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     N,  # number of cols (length to scan)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     BLOCK: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m ):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # One program per row
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     row = tl.program_id(0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Create a vector of indices [0..BLOCK)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     offs = tl.arange(0, BLOCK)
