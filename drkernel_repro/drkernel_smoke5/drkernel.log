[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         self.conv_transpose = nn.ConvTranspose3d(in_channels, out_channels, kernel_size,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m                                                  stride=stride, padding=padding)
