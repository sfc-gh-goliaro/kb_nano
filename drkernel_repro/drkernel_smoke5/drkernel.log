[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m @triton.jit
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m def dw_conv_kxk_fused_kernel(
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     x_ptr, w_ptr, bias_ptr, weight_ptr, bias2_ptr, out_ptr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     N, C, H, W,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     K: tl.constexpr,
