[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Load weights W[oc, ic] -> [BC,BIC]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         w_idx = (oc[:, None] * w_stride_oc) + (ic_[None, :] * w_stride_ic)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         w_val = tl.load(w_ptr + w_idx, mask=(mask_oc[:, None] & mask_ic[None, :]), other=0.0)  # [BC,BIC]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Load x[n, ic, h, w] -> [BIC,BH,BW]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         x_idx = (
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             pid_n * stride_n
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             + ic_[:, None, None] * stride_c
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             + h[None, :, None] * stride_h
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             + w[None, None, :] * stride_w
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         )
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         x_mask = (mask_ic[:, None, None]) & (mask_hw[None, :, None])
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         x_val = tl.load(x_ptr + x_idx, mask=x_mask, other=0.0)  # [BIC,BH,BW]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Accumulate: for each bic, acc += x[:,:,bic] * w[bic,:]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         x_t = tl.trans(x_val, (1, 2, 0))  # [BH,BW,BIC]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         w_t = tl.trans(w_val, (1, 0))     # [BIC,BC]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         for bic in range(0, BLOCK_C):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             if bic < C_in - ic:  # simple guard
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m                 x_slice = x_t[:, :, bic]  # [BH,BW]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m                 w_slice = w_t[bic, :]     # [BC]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m                 acc += x_slice[:, :, None] * w_slice[None, None, :]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Add conv bias
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     bconv = tl.load(bconv_ptr + oc, mask=mask_oc, other=0.0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     acc = acc + bconv[None, None, :]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     if has_bn:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # BN(eval): scale = weight / sqrt(var + eps); shift = bias - mean * scale
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         scale = tl.load(weight_ptr + oc, mask=mask_oc, other=1.0) / tl.sqrt(tl.load(bias_ptr + oc, mask=mask_oc, other=1.0) + eps)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         shift = tl.load(bias_ptr + oc, mask=mask_oc, other=0.0) - tl.load(weight_ptr + oc, mask=mask_oc, other=1.0) * scale
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         acc = acc * scale[None, None, :] + shift[None, None, :]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # ReLU6
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     acc = tl.maximum(acc, 0.0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     acc = tl.minimum(acc, 6.0)
