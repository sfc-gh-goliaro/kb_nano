[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         acc = acc * scale[None, None, :] + shift[None, None, :]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     zero = 0.0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     six = 6.0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     acc = tl.maximum(acc, zero)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     acc = tl.minimum(acc, six)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     out_idx = (
