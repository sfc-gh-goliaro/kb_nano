[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m # Triton kernel: cumulative sum along dim=1 for a 2D tensor (M, N), one program per row.
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m @triton.jit
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m def _cumsum_2d_axis1_kernel(
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     x_ptr,               # *const T
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     y_ptr,               # *T
