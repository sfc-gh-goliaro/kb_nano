[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m @triton.autotune(
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     configs=[
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         triton.Config({'BLOCK_M': 128, 'BLOCK_N': 128, 'BLOCK_K': 32}, num_warps=4, num_stages=3),
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         triton.Config({'BLOCK_M': 128, 'BLOCK_N': 128, 'BLOCK_K': 64}, num_warps=8, num_stages=4),
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         triton.Config({'BLOCK_M': 64,  'BLOCK_N': 128, 'BLOCK_K': 64}, num_warps=4, num_stages=4),
