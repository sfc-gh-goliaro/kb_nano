[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Store
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     out_idx = (
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         pid_n * out_stride_n
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         + oc[:, None, None] * out_stride_c
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         + h[None, :, None] * out_stride_h
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         + w[None, None, :] * out_stride_w
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     )
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     out_mask = (mask_oc[:, None, None]) & (mask_hw[None, :, None])
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     tl.store(out_ptr + out_idx, acc, mask=out_mask)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
