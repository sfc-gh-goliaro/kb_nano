[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Grid: one program per (b, h, w)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         grid = (B * H * W,)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
