[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         w = self.linear.weight
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         b = self.linear.bias
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Pre-scale weight^T and bias: this removes per-element multiply in kernel
