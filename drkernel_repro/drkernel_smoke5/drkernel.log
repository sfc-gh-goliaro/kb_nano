[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         _fused_softmax_tanh_scale_5d_kernel[grid](
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             x, self.bias.view(-1).contiguous(), out,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             B, C, H, W,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             stride_b, stride_c, stride_d, stride_h, stride_w,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             self.scaling_factor,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             BLOCK_C=block_c,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             num_warps=4,  # heuristic
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             num_stages=2,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         )
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
