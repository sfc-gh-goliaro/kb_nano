[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     num_w_tiles = tl.cdiv(W, BLOCK_W)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     th = pid_hw // num_w_tiles
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     tw = pid_hw % num_w_tiles
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     oh = th * BLOCK_H + tl.arange(0, BLOCK_H)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     ow = tw * BLOCK_W + tl.arange(0, BLOCK_W)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     c  = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     HO, WO = H, W  # no pooling; output size equals input
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     PH = (H - 1) // 2
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     PW = (W - 1) // 2
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     mask_hw = (oh < HO) & (ow < WO)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     mask_c  = c < C
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     acc = tl.zeros((BLOCK_H, BLOCK_W, BLOCK_C), dtype=tl.float32)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Loop over kernel KxK
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     for dh in range(0, K):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         for dw in range(0, K):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             ih = oh + dh - PH
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             iw = ow + dw - PW
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             valid = (ih >= 0) & (ih < H) & (iw >= 0) & (iw < W) & mask_hw
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             # x[n, c, ih, iw] -> [BC,BH,BW]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             x_idx = (
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m                 pid_n * stride_n
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m                 + c[:, None, None] * stride_c
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m                 + ih[None, :, None] * stride_h
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m                 + iw[None, None, :] * stride_w
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             )
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             x_val = tl.load(x_ptr + x_idx, mask=(mask_c[:, None, None] & valid[None, :, None]), other=0.0)  # [BC,BH,BW]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             # w[c, dh, dw] -> [BC]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             w_idx = c * w_stride_c + dh * w_stride_dh + dw * w_stride_dw
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             w_val = tl.load(w_ptr + w_idx, mask=mask_c, other=0.0)  # [BC]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             acc += x_val * w_val[:, None, None]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Bias (pre-activation)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     b = tl.load(bias_ptr + c, mask=mask_c, other=0.0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     acc = acc + b[None, None, :]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     if has_bn:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         scale = tl.load(weight_ptr + c, mask=mask_c, other=1.0) / tl.sqrt(tl.load(bias2_ptr + c, mask=mask_c, other=1.0) + eps)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         shift = tl.load(bias2_ptr + c, mask=mask_c, other=0.0) - tl.load(weight_ptr + c, mask=mask_c, other=1.0) * scale
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         acc = acc * scale[None, None, :] + shift[None, None, :]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # ReLU6
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     acc = tl.maximum(acc, 0.0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     acc = tl.minimum(acc, 6.0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Store
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     out_idx = (
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         pid_n * out_stride_n
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         + c[:, None, None] * out_stride_c
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         + oh[None, :, None] * out_stride_h
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         + ow[None, None, :] * out_stride_w
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     )
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     out_mask = (mask_c[:, None, None]) & (mask_hw[None, :, None])
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     tl.store(out_ptr + out_idx, acc, mask=out_mask)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
