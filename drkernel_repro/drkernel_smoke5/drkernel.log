[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     def __init__(self, in_features, out_features, scaling_factor):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         super(ModelNew, self).__init__()
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         self.linear = nn.Linear(in_features, out_features)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         self.scaling_factor = float(scaling_factor)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     def forward(self, x: torch.Tensor) -> torch.Tensor:
