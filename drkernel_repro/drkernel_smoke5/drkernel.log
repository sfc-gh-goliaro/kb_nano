[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     c0 = 0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     while c0 < C:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         offs = c0 + tl.arange(0, BLOCK_C)
