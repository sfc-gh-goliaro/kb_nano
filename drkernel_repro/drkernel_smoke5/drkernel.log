[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m def _triton_matmul(A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     """
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     Compute C = A @ B using Triton.
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     A: (M, K) logically; here provided as shape (K, M) but we index with strides as (M, K)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     B: (K, N)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     Returns C: (M, N)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     """
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     assert A.dim() == 2 and B.dim() == 2, f"Expected 2D tensors, got {A.shape}, {B.shape}"
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Shapes
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # We want A as (M, K), B as (K, N)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     K_A, M = A.shape
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     K_B, N = B.shape
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     assert K_A == K_B, f"Incompatible K dims: {K_A} != {K_B}"
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     K = K_A
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Device check
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     if not A.is_cuda or not B.is_cuda:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Fallback to torch if not on CUDA
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         return torch.matmul(A.t(), B)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Dtype check: use float32
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     if A.dtype != torch.float32 or B.dtype != torch.float32:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Fallback or cast; to keep it simple and correct, fallback
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         return torch.matmul(A.t(), B)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Strides in elements
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Note: PyTorch stride is in elements already.
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # We logically treat A as (M, K); its storage is (K, M).
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # So for A logical (M, K):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     #   sAM = A.stride over 'M' dim = A.stride(1)   -> points to next column in logical (M, K)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     #   sAK = A.stride over 'K' dim = A.stride(0)   -> points to next row in logical (M, K)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     sAM = A.stride(1)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     sAK = A.stride(0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # B is physical (K, N): strides match logical
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     sBK = B.stride(0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     sBN = B.stride(1)
