[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # We'll infer dtype from loads; start from 0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     carry = 0.0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     start = 0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     while start < N:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         offs = start + cols
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         mask = offs < N
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Compute pointers for this tile
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         ptrs = x_ptr + row * stride_m + offs * stride_n
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Load values; out-of-bounds => 0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         vals = tl.load(ptrs, mask=mask, other=0.0)
