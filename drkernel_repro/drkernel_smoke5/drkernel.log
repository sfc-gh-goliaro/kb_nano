[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m @triton.jit
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m def conv1x1_pointwise_fused_kernel(
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     x_ptr, w_ptr, bconv_ptr, weight_ptr, bias_ptr, out_ptr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     N, C_in, C_out, H, W,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     stride_n, stride_c, stride_h, stride_w,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     w_stride_oc, w_stride_ic,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     out_stride_n, out_stride_c, out_stride_h, out_stride_w,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     has_bn: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     eps: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     BLOCK_C: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     BLOCK_H: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     BLOCK_W: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m ):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Grid: (N, tiles_HW, tiles_C)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     pid_n = tl.program_id(0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     pid_hw = tl.program_id(1)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     pid_c = tl.program_id(2)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     num_w_tiles = tl.cdiv(W, BLOCK_W)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     th = pid_hw // num_w_tiles
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     tw = pid_hw % num_w_tiles
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     h = th * BLOCK_H + tl.arange(0, BLOCK_H)
