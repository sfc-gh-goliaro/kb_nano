[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m @triton.jit
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m def _matmul_bias_scale_kernel(
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     A, B, Bias, C,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     M, N, K,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     stride_am, stride_ak,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     stride_bk, stride_bn,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     stride_cm, stride_cn,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     scale,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Meta-parameters
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m ):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Program ids
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     pid_m = tl.program_id(0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     pid_n = tl.program_id(1)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Offsets
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     offs_k = tl.arange(0, BLOCK_K)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Pointers to the first K-block
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     A_ptr = A + (offs_m[:, None] * stride_am + offs_k[None, :] * stride_ak)  # (BM, BK)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     B_ptr = B + (offs_k[:, None] * stride_bk + offs_n[None, :] * stride_bn)  # (BK, BN)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Accumulator
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Loop over K
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     for k in range(0, K, BLOCK_K):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         a = tl.load(
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             A_ptr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             mask=(offs_m[:, None] < M) & (offs_k[None, :] + k < K),
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             other=0.0,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         )
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         b = tl.load(
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             B_ptr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             mask=(offs_k[:, None] + k < K) & (offs_n[None, :] < N),
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             other=0.0,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         )
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Accumulate
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         acc += tl.dot(a, b)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Advance by BLOCK_K along K
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         A_ptr += BLOCK_K * stride_ak
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         B_ptr += BLOCK_K * stride_bk
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Add bias (broadcast over rows)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     bias = tl.load(Bias + offs_n, mask=offs_n < N, other=0.0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     acc = acc + bias[None, :]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Fuse scaling
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     acc = acc * scale
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Store
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     C_ptr = C + (offs_m[:, None] * stride_cm + offs_n[None, :] * stride_cn)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     tl.store(
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         C_ptr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         acc,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         mask=(offs_m[:, None] < M) & (offs_n[None, :] < N),
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     )
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m class ModelNew(nn.Module):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     """
