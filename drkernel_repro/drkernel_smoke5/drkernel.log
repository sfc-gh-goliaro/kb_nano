[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m @triton.jit
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m def mean_depth_vec_kernel(
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     x_ptr, y_ptr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     B, C, D, H, W,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     sN, sC, sD, sH, sW,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     out_sN, out_sC, out_sD, out_sH, out_sW,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     BLOCK_W: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m ):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # 2D grid:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     #  - pid0 indexes over (b, c, h)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     #  - pid1 indexes over width blocks
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     pid0 = tl.program_id(0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     pid1 = tl.program_id(1)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     CH = C * H
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     b = pid0 // CH
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     rem = pid0 % CH
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     c = rem // H
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     h = rem % H
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     w_start = pid1 * BLOCK_W
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     offs_w = w_start + tl.arange(0, BLOCK_W)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     mask = offs_w < W
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # base pointer for d=0, w block
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     base = b * sN + c * sC + h * sH + offs_w * sW
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # fp32 accumulator for this block
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     acc = tl.zeros([BLOCK_W], dtype=tl.float32)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # loop over depth, accumulate vector
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     d = 0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     while d < D:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         ptrs = x_ptr + base + d * sD
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         vals = tl.load(ptrs, mask=mask, other=0.0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         acc += vals.to(tl.float32)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         d += 1
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     mean = acc / D
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # store to y at d=0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     out_ptrs = y_ptr + b * out_sN + c * out_sC + h * out_sH + offs_w * out_sW
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     tl.store(out_ptrs, mean, mask=mask)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
