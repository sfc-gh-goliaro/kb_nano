[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     if has_bn:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         scale = tl.load(weight_ptr + c, mask=mask_c, other=1.0) / tl.sqrt(tl.load(bias2_ptr + c, mask=mask_c, other=1.0) + eps)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         shift = tl.load(bias2_ptr + c, mask=mask_c, other=0.0) - tl.load(weight_ptr + c, mask=mask_c, other=1.0) * scale
