[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Allocate output (M, N)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     C = torch.empty((M, N), device=A.device, dtype=torch.float32)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     sCM = C.stride(0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     sCN = C.stride(1)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Tile config (can be tuned)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     BLOCK_M = 128
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     BLOCK_N = 128
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     BLOCK_K = 32
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     grid = (triton.cdiv(M, BLOCK_M), triton.cdiv(N, BLOCK_N))
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     matmul_kernel[grid](
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         A, B, C,
