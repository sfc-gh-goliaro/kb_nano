[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m @triton.jit
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m def cumsum_rows_kernel(x_ptr, y_ptr, N, BLOCK: tl.constexpr):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     """
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     Inclusive cumulative sum along dim=1 for a 2D tensor [M, N] (row-major contiguous).
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     Parallel, block-wise scan per row.
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     Args:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         x_ptr: *const float32
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         y_ptr: *float32
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         N: int (number of columns)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         BLOCK: int (tile width, power of two preferred)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     """
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # One program per row
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     row = tl.program_id(0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     row_start = row * N
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Running carry of sum of all previous tiles for this row
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     carry = 0.0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     start = 0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     while start < N:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         cols = start + tl.arange(0, BLOCK)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         mask = cols < N
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Load tile with mask; out-of-bounds as 0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         x = tl.load(x_ptr + row_start + cols, mask=mask, other=0.0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Vector of lane indices
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         idx = tl.arange(0, BLOCK)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Compute inclusive scan within the tile using Hillis–Steele
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # working vector 'tmp' starts as x
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         tmp = x
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         offset = 1
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         while offset < BLOCK:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             # shifted = tmp[idx - offset] if idx >= offset else 0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             shifted = tl.where(idx >= offset, tmp[idx - offset], 0.0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             tmp = tmp + shifted
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             offset *= 2
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # The above 'tmp' is inclusive scan of x.
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Exclusive scan within tile: s = tmp - x  (except lane 0 which becomes 0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         s = tmp - x
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Store exclusive scan result for this tile (pre-carry); add carry on Python side after next step
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # But we need to store post-carry values: s + carry
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         out = s + carry
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         tl.store(y_ptr + row_start + cols, out, mask=mask)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Update carry: carry += sum of this tile's x
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Reduce sum over vector lanes
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         sum_tile = 0.0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         for t in range(0, BLOCK):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             sum_tile += x[t]
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         carry = carry + sum_tile
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         start += BLOCK
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m class ModelNew(torch.nn.Module):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     def __init__(self, dim: int):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         super().__init__()
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         self.dim = dim
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     def forward(self, x: torch.Tensor) -> torch.Tensor:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Fallbacks and checks
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         if not x.is_cuda:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             raise AssertionError("ModelNew requires CUDA tensor")
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         if x.dtype != torch.float32:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             raise AssertionError("ModelNew currently supports float32 only")
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         if x.dim() != 2:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             raise AssertionError(f"Expected 2D tensor, got shape {tuple(x.shape)}")
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         if self.dim != 1:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             raise AssertionError(f"This implementation supports dim=1, got dim={self.dim}")
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         if not x.is_contiguous():
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             x = x.contiguous()
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         M, N = x.shape
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         y = torch.empty_like(x)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         BLOCK = 1024  # power of two; good starting point
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         grid = (M,)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         cumsum_rows_kernel[grid](
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             x, y,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             N,
