[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     w_stride_c, w_stride_dh, w_stride_dw,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     out_stride_n, out_stride_c, out_stride_h, out_stride_w,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     has_bn: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     eps: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     BLOCK_C: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     BLOCK_H: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     BLOCK_W: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m ):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Grid: (N, tiles_HO*WO, tiles_C)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     pid_n = tl.program_id(0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     pid_hw = tl.program_id(1)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     pid_c = tl.program_id(2)
