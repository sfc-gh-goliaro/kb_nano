[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     def __init__(self, in_channels, out_channels, kernel_size, stride, padding, scaling_factor):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         super(ModelNew, self).__init__()
