[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Loop over input channels in blocks
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     for ic in range(0, C_in, BLOCK_C):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         ic_ = ic + tl.arange(0, BLOCK_C)
