[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m def _ceil_div(a, b):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     return (a + b - 1) // b
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m # Simple elementwise kernel: out[i] = 2 * x[i] + 3
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m if _HAS_TRITON:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     @triton.autotune(
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         configs=[
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             triton.Config({'BLOCK_SIZE': 1024}, num_warps=4),
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             triton.Config({'BLOCK_SIZE': 2048}, num_warps=4),
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m             triton.Config({'BLOCK_SIZE': 4096}, num_warps=8),
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         ],
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         key=['n_elements'],
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     )
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     @triton.jit
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     def _affine_kernel(x_ptr, out_ptr, n_elements, BLOCK_SIZE: tl.constexpr):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         pid = tl.program_id(0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         offs = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         mask = offs < n_elements
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         x = tl.load(x_ptr + offs, mask=mask, other=0.0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Compute in same dtype as x to match PyTorch numerics
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         y = x * 2.0 + 3.0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         tl.store(out_ptr + offs, y, mask=mask)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
