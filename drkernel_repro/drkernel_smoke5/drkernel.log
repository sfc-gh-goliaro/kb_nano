[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m ```python
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m import math
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m import torch
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m import torch.nn as nn
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m try:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     import triton
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     import triton.language as tl
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     TRITON_AVAILABLE = True
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m except Exception:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     TRITON_AVAILABLE = False
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m # 2D kernel: cumulative sum along dim=1 (columns) for each row
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m @triton.jit
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m def _cumsum_2d_dim1_kernel(
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     x_ptr, y_ptr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     M, N,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     stride_xm, stride_xn,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     stride_ym, stride_yn,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     BLOCK_N: tl.constexpr,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m ):
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # program ids
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     pid_m = tl.program_id(0)  # row index
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     pid_blk = tl.program_id(1)  # block index along N
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # starting column for this block
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     col_start = pid_blk * BLOCK_N
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # vector of column offsets within block
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     offs = col_start + tl.arange(0, BLOCK_N)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # mask for valid columns
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     mask = offs < N
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # row base pointers
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     row_x_ptr = x_ptr + pid_m * stride_xm
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     row_y_ptr = y_ptr + pid_m * stride_ym
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # load block; out-of-bounds columns get 0
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     x = tl.load(row_x_ptr + offs * stride_xn, mask=mask, other=0.0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # running prefix within the block
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     y = tl.zeros([BLOCK_N], dtype=x.dtype)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     carry = tl.zeros((), dtype=x.dtype)  # scalar
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m 
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     # Hillis–Steele inclusive scan within the block
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     offset = 1
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m     while offset < BLOCK_N:
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # only update lanes whose index >= offset
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         idx = tl.arange(0, BLOCK_N)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         upd_mask = (idx >= offset) & mask
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # shifted values: y[i - offset] but only where valid
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # create a shifted version by indexing with (idx - offset)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Note: negative indices are fine as long as we mask.
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         shifted_idx = idx - offset
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # gather y at shifted positions where valid
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # We can't directly index tensors with a vector of indices in Triton this way,
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # so we build shifted values via where.
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # Alternative: compute y_shift = where(upd_mask, y[shifted_idx], 0)
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # But Triton doesn't support such advanced indexing; we do it by using
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # the property that lanes with idx < offset don't update: set their contribution to 0.
[36m(MultiTurnAsyncvLLMEngine pid=1400823)[0m         # We'll compute y += where(upd_mask, y_shifted, 0) but need y_shifted.
